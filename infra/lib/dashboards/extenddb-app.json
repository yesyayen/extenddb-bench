    {
      "id": 101,
      "type": "timeseries",
      "title": "Request rate (req/s) by operation",
      "datasource": {
        "type": "postgres",
        "uid": "extenddb-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "extenddb-pg"
          },
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, (count::float / 60.0) AS value, operation AS metric FROM metrics WHERE metric = 'RequestCount' AND $__timeFilter(bucket) AND operation IN ('GetItem','PutItem','UpdateItem','DeleteItem','Query','Scan','BatchGetItem','BatchWriteItem','TransactGetItems','TransactWriteItems') ORDER BY bucket"
        }
      ]
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "Availability % by operation (1 - SystemErrors/RequestCount)",
      "datasource": {
        "type": "postgres",
        "uid": "extenddb-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "extenddb-pg"
          },
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, CASE WHEN total > 0 THEN 100.0 * (total - errors)::float / total ELSE 100 END AS value, op AS metric FROM (SELECT bucket, operation AS op,   SUM(CASE WHEN metric = 'RequestCount' THEN count ELSE 0 END) AS total,   SUM(CASE WHEN metric = 'SystemErrors' THEN count ELSE 0 END) AS errors   FROM metrics WHERE $__timeFilter(bucket) AND operation IN ('GetItem','PutItem','UpdateItem','DeleteItem','Query','Scan','BatchGetItem','BatchWriteItem','TransactGetItems','TransactWriteItems')   GROUP BY bucket, operation) sub WHERE total > 0 ORDER BY time"
        }
      ],
      "description": "Availability per minute. 100% means no SystemErrors. 4xx and throttles are not counted as unavailability."
    },
